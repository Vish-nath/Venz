{
  "name": "venz-snake-safety",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @venz/api",
    "dev:web": "npm run dev --workspace @venz/web",
    "build": "npm run build --workspace @venz/web",
    "start": "node apps/api/src/server.js",
    "start:api": "npm run start --workspace @venz/api"
  },
  "devDependencies": { "concurrently": "^9.1.0" },
  "engines": { "node": ">=20" }
}
